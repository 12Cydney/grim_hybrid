# =====================================================================
# Grim Hybrid v1 - .gitignore
# =====================================================================
# What we track:  source code + config + docs + tests
# What we DON'T:  generated artifacts, logs, secrets, venvs, IDE junk
# =====================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/

# ---------- Generated data ----------
# Training CSVs are regenerated by the collector - never track them.
data/training/*.csv
data/training/*.parquet
data/**/backup_*
!data/training/.gitkeep

# ---------- Trained models ----------
# Models are 200KB-2MB binary blobs regenerated by the trainer.
# We DO track the metrics .json files so git history shows accuracy over time.
models/*.pkl
!models/.gitkeep

# ---------- Logs ----------
logs/
*.log
/var/log/grimhybrid.log

# ---------- MT5 build artifacts ----------
# Only track the .mq5 source; MT5 compiles .ex5 locally on each machine.
mt5/*.ex5
mt5/*.ex4
mt5/GrimHybridEA_ZMQ.log

# ---------- Secrets / local config ----------
.env
.env.*
!.env.example
config.local.yaml
secrets.yaml
*.pem
*.key

# ---------- IDE / OS junk ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Test outputs ----------
test_reports/
htmlcov/
.coverage
.tox/
